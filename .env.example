# Optional local settings for ignored live-agent evaluation.
SUBBAKE_EVAL_CONFIG=/home/you/.config/subbake/config.toml
SUBBAKE_EVAL_PROFILE=your-profile
SUBBAKE_EVAL_REPETITIONS=3

# Needed only when the selected backend uses api_key_env instead of an inline
# key. Use the same variable name configured for that backend.
YOUR_PROVIDER_API_KEY=
